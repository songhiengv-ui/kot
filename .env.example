# Public (safe in browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Capture pipeline (chosen after Phase 4 benchmark)
# Speech-to-text (lib/stt.ts, Gemini REST). Do NOT use flash-lite models: in testing one heard ៣០០ for ១០០.
STT_PROVIDER=gemini
STT_MODEL=gemini-3-flash-preview:minimal
STT_FALLBACK_MODELS=gemini-flash-latest
STT_API_KEY=
# Text extraction fallback (lib/extract.ts) for entries the deterministic parser can't place.
# EXTRACT_PROVIDER=gemini|anthropic. Unset → anthropic if an Anthropic key is set, else gemini on STT_API_KEY.
# Default models: gemini-3-flash-preview:minimal (~1 s) / claude-haiku-5-5. No key at all → deterministic parse only.
EXTRACT_PROVIDER=
EXTRACT_MODEL=
EXTRACT_API_KEY=

# Chirp 3 streaming (optional; voice falls back to Gemini when unset or failing).
# Needs a service account with the "Cloud Speech Client" role — Chirp rejects API keys.
GOOGLE_SERVICE_ACCOUNT_JSON=
CHIRP_PROJECT_ID=
CHIRP_REGION=us
# "same-origin" on Vercel (uses /api/voice/stream), ws://localhost:8787 in dev (npm run stt-relay)
NEXT_PUBLIC_STT_STREAM_URL=
